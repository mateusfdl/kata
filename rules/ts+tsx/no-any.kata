rule no-any {
  lang ts, tsx

  match type_annotation @match {
    child: predefined_type @t
  }

  where {
    text(@t) == "any"
  }

  emit @match {
    message "any is not allowed - use a proper type"
  }
}

rule no-any {
  lang ts, tsx

  match type_annotation @match {
    child: array_type {
      child: predefined_type @t
    }
  }

  where {
    text(@t) == "any"
  }

  emit @match {
    message "any[] is not allowed - use a proper type"
  }
}

rule no-any {
  lang ts, tsx

  match type_arguments @match {
    child: [predefined_type @t, array_type { child: predefined_type @t }]
  }

  where {
    text(@t) == "any"
  }

  emit @match {
    message "any as type argument is not allowed - use a proper type"
  }
}
