rule no-weak-assertions {
  lang ts

  match call_expression @match {
    function: member_expression {
      object: call_expression {
        function: identifier @expect
      }
      property: property_identifier @name
    }
  }

  where {
    text(@expect) == "expect"
    text(@name) in [
      "toBeDefined",
      "toBeUndefined",
      "toBeNull",
      "toBeTruthy",
      "toBeFalsy",
      "toHaveBeenCalled",
      "toContain",
    ]
  }

  emit @match {
    message "weak assertion - use .toEqual() with explicit values"
  }
}
