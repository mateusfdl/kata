rule no-as-any {
  lang ts

  match as_expression @match {
    child: predefined_type @t
  }

  where {
    text(@t) == "any"
  }

  emit @match {
    message "as any is not allowed - use a proper type to represent it"
  }
}

rule no-as-any {
  lang ts

  match as_expression @match {
    child: array_type {
      child: predefined_type @t
    }
  }

  where {
    text(@t) == "any"
  }

  emit @match {
    message "as any[] is not allowed - use a proper type to represent it"
  }
}
